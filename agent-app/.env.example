# Plause agent-app only. No secrets are copied from the separate Worker staging.
# Never commit .env.local. Hosted installations require explicit unique secrets.
# Local workflow files require persistent disk. Cloudflare Containers must select
# postgres at BUILD and runtime; use a session-capable PostgreSQL connection.
PLAUSE_WORKFLOW_BACKEND=local
WORKFLOW_POSTGRES_URL=
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=4
WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
WORKFLOW_POSTGRES_POLL_INTERVAL_MS=2000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Generate a separate 32-byte base64 key; preserve it with encrypted DB backups.
SECRET_ENCRYPTION_KEY=
INTERNAL_SERVICE_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct

# Private R2 bucket, with bucket-scoped read/write credentials. Public access off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Direct OpenAI. Adding a key alone does not enable inference.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_BROWSER_MODEL=gpt-6-luna
LIVE_MODEL_ENABLED=false
# User-approved scheduled tasks; Cloudflare wake alarms remain off until enabled.
SCHEDULED_TASKS_ENABLED=false
MODEL_MAX_INPUT_TOKENS=20000
MODEL_MAX_OUTPUT_TOKENS=2000
MODEL_TIMEOUT_MS=20000
# 1 USD = 1,000,000 micro USD. App reservations are not a provider invoice cap.
MODEL_USER_MONTHLY_BUDGET_MICRO_USD=30000
MODEL_GLOBAL_MONTHLY_BUDGET_MICRO_USD=30000

# Runtime defaults to disabled. This example selects Linq; blank keys keep it unavailable.
MESSAGING_PROVIDER=linq
# Empty means hosted enrollment is closed to everyone. Exact E.164 values only.
PRIVATE_ALLOWED_PHONE_NUMBERS=
# Optional fallback: MESSAGING_PROVIDER=inkbox. Credentials never trigger automatic fallback.
# Inkbox uses a configured identity and shared first-connect router, not a hardcoded line.
# Use a lowercase handle without @. Resolve the router, send connect @<handle>, then say hi.
# Signed webhook: https://<host>/webhooks/inkbox; internal HMAC relay: /internal/inkbox/dispatch.
INKBOX_API_KEY=
INKBOX_IDENTITY_ID=
INKBOX_AGENT_HANDLE=
INKBOX_WEBHOOK_SIGNING_KEY=

# Primary provider: configure the exact Linq-assigned E.164 line after sandbox activation.
# Signed webhook: https://<host>/webhooks/linq.
LINQ_API_KEY=
LINQ_PHONE_NUMBER=
LINQ_WEBHOOK_SIGNING_SECRET=

# Separate Workspace OAuth client; callback is /api/connections/google/callback.
# Users review scopes at /connections/google before connecting their account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_WRITES_ENABLED=false

# Required by browser tools. Credentials remain server-side.
BROWSER_ACTIONS_ENABLED=false
KERNEL_API_KEY=

# Optional Link wallet connection. Purchases are unavailable in this adaptation.
LINK_CLIENT_ID=
LINK_CLIENT_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Local browser benchmarks only; these may use paid provider services.
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1

# Public-query research is optional and separately approved per query.
# Uses the same conservative application spending ledger as model calls.
TAVILY_API_KEY=
WEB_RESEARCH_ENABLED=false

# Disable vendor CLI telemetry in this private installation.
EVE_TELEMETRY_DISABLED=1
NEXT_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# Cloudflare Container callbacks only: a distinct random >=32-character edge token.
# This complements INTERNAL_SERVICE_SECRET signatures; leave unset for local development.
PLAUSE_EDGE_INTERNAL_TOKEN=
