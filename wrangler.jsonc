{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plause-local",
  "main": "apps/api/src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "APP_ENV": "local", "MODEL_PROVIDER": "mock", "MESSAGING_PROVIDER": "mock" },
  "assets": { "directory": "apps/api/public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "plause-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "plause-local-jobs" }],
    "consumers": [{ "queue": "plause-local-jobs", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3 }]
  },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false }
}
